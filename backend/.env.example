# CloudGov Backend Environment Configuration
PROJECT_NAME="CloudGov Platform API"
ENVIRONMENT=production
DEBUG=False

# Generate a secure 32-byte secret: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (AWS RDS PostgreSQL or local instance)
# Format: postgresql://[user]:[password]@[rds-endpoint]:5432/[dbname]
DATABASE_URL=postgresql://cloudgov_admin:YourStrongPassword@localhost:5432/cloudgov_db

# AWS Cloud Settings (Free Tier S3, SES, SNS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=cloudgov-document-vault

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://YOUR_EC2_PUBLIC_IP
